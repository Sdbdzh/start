<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 启动窗口基础主题：颜色完全交给 Compose 接管。
         启动画面（SplashScreen）保持到首帧内容就绪，避免主题/页面切换闪烁 -->
    <style name="Theme.Start" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/start_window_bg</item>
        <item name="android:windowSplashScreenBackground">@color/start_window_bg</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/start_window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
